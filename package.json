{
  "name": "@mechazawa/bootstrap4-notify",
  "version": "1.0.2",
  "description": "Turns standard Bootstrap 4 alerts into \"Growl-like\" notifications. Port of bootstrap-notify by Robert McIntosh.",
  "keywords": [
    "bootstrap",
    "bootstrap4",
    "jquery",
    "notify",
    "notification",
    "growl",
    "alert"
  ],
  "homepage": "https://github.com/Mechazawa/bootstrap4-notify#readme",
  "bugs": {
    "url": "https://github.com/Mechazawa/bootstrap4-notify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mechazawa/bootstrap4-notify.git"
  },
  "license": "MIT",
  "author": "Bas Bieling",
  "type": "module",
  "main": "./dist/bootstrap-notify.umd.cjs",
  "module": "./src/bootstrap-notify.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./src/bootstrap-notify.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/bootstrap-notify.umd.cjs"
      }
    }
  },
  "unpkg": "./dist/bootstrap-notify.umd.min.js",
  "jsdelivr": "./dist/bootstrap-notify.umd.min.js",
  "files": [
    "src",
    "dist",
    "index.d.ts",
    "index.d.cts"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "build": "rollup -c && cp index.d.ts index.d.cts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run attw",
    "typecheck": "tsc --noEmit --strict index.d.ts",
    "attw": "attw --pack ."
  },
  "peerDependencies": {
    "@types/jquery": "^3.0.0 || ^4.0.0",
    "bootstrap": "^4.0.0",
    "jquery": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/jquery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/jquery": "^4.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jquery": "^3.7.1",
    "jsdom": "^29.1.1",
    "rollup": "^4.67.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
